<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.delivery</groupId>
    <artifactId>swiftdrop</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>delivery-notify</artifactId>
  <name>delivery-notify</name>
  <description>通知模块：WebSocket 长连接、订单状态与骑手位置推送</description>

  <dependencies>
    <dependency>
      <groupId>com.delivery</groupId>
      <artifactId>delivery-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- 监听 order / rider 的事件并转成推送。
         注意依赖方向：notify 是「消费方」，order / rider 不反向依赖 notify，
         所以不会形成循环。 -->
    <dependency>
      <groupId>com.delivery</groupId>
      <artifactId>delivery-order</artifactId>
    </dependency>
    <dependency>
      <groupId>com.delivery</groupId>
      <artifactId>delivery-rider</artifactId>
    </dependency>
  </dependencies>
</project>
