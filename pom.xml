<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.delivery</groupId>
    <artifactId>swiftdrop</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>SwiftDrop</name>
    <description>同城即时配送调度平台</description>

    <modules>
        <module>delivery-common</module>
        <module>delivery-rider</module>
        <module>delivery-order</module>
        <module>delivery-dispatch</module>
        <module>delivery-notify</module>
        <module>delivery-admin</module>
        <module>delivery-ai</module>
        <module>delivery-boot</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Spring AI 1.0.0-M6：这是兼容 Spring Boot 3.2.x 的最后一个里程碑版本。
              1.0.0 GA 与 1.1.x 都要求 Boot 3.4+，本项目锁定 3.2.5 不可升级，
              因此只能用 M6。BOM 必须 import 在 dependencyManagement 最前面，
              否则下面的 Spring AI starter 拿不到版本。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0-M6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency><groupId>com.delivery</groupId><artifactId>delivery-common</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.delivery</groupId><artifactId>delivery-order</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.delivery</groupId><artifactId>delivery-rider</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.delivery</groupId><artifactId>delivery-dispatch</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.delivery</groupId><artifactId>delivery-notify</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.delivery</groupId><artifactId>delivery-admin</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.delivery</groupId><artifactId>delivery-ai</artifactId><version>${project.version}</version></dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <compilerArgs><arg>-parameters</arg></compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>